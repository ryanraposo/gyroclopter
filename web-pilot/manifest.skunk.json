{
  "manifest_version": 3,
  "name": "Gyroclopter · Skunk Works",
  "version": "0.6.0",
  "description": "Experimental always-ready Web Pilot. Pair once, then control ordinary web pages with Gyroclopter.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "debugger", "background"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["interaction-field.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Gyroclopter · Skunk Works",
    "default_popup": "popup-skunk.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
